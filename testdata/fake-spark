#!/usr/bin/env bash
# Fake spark CLI for tests. Records every invocation and answers with
# synthetic fixtures. Never put real mailbox data here.
#   FAKE_SPARK_DIR      directory for call records (calls.log, stdin-<n>)
#   FAKE_SPARK_CATALOG  catalog JSON printed by `spark tools`
set -u
dir="${FAKE_SPARK_DIR:?}"
n=$(($(find "$dir" -name 'stdin-*' | wc -l) + 1))
{
  printf 'agent=%s' "${AI_AGENT:-}"
  for a in "$@"; do printf '\x1f%s' "$a"; done
  printf '\n'
} >> "$dir/calls.log"
if [ ! -t 0 ]; then cat > "$dir/stdin-$n"; else : > "$dir/stdin-$n"; fi

all="$*"
case "$all" in
  *trigger-sleep*) sleep 5 ;;
  *trigger-error*) echo "Error: no thread found for \"1\"." >&2; exit 1 ;;
  *trigger-offline*) echo "Error: Spark Desktop is not running." >&2; exit 1 ;;
  *trigger-big*) head -c 200000 /dev/zero | tr '\0' 'x'; exit 0 ;;
esac

case "${1:-}" in
  --version) echo "1.3.1" ;;
  tools) cat "${FAKE_SPARK_CATALOG:?}" ;;
  attachment)
    if [ "${2:-}" = "--stream" ]; then
      printf '\x89PNG\r\n\x1a\nfake-image-bytes'
    else
      id="${3:-}"
      [ "$id" = "404" ] && { echo "Error: no attachment found for ID 404."; exit 1; }
      printf 'ID: %s\nName: photo.png\nSize: 24\nMIME Type: IMAGE/PNG; name=photo.png\nPath: /tmp/photo.png\nMessage ID: 555\n' "$id"
    fi ;;
  draft)
    if [ "${2:-}" = "--edit=777" ] && [[ "${3:-}" == --attach-stream=* ]]; then
      echo "Draft 777 updated."
    else
      echo "Draft saved."
    fi
    echo "ID: 777"
    echo "Link: https://sparkmailapp.com/dpl/bl?token=test" ;;
  comment) echo "Comment posted." ;;
  *) echo "ok: $all" ;;
esac
